# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_api_key_here
EVOLUTION_INSTANCE_NAME=triage-bot

# WhatsApp Group
TARGET_GROUP_JID=                      # Format: 1234567890-1234567890@g.us

# Anthropic
ANTHROPIC_API_KEY=

# Google Cloud Vision
GOOGLE_CLOUD_CREDENTIALS_JSON=         # Base64-encoded service account JSON

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=screenshots

# Server
PORT=3000
WEBHOOK_SECRET=                        # Random string, set in Evolution API config too

# Jira connection (optional — leave all four blank to disable Jira issue creation)
JIRA_HOST=                             # e.g. yourteam.atlassian.net (no https://)
JIRA_EMAIL=                            # Atlassian account email
JIRA_API_TOKEN=                        # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=                      # e.g. BUG or KAN (the prefix on issue keys)

# Jira mapping (optional — defaults work for most spaces; run `pnpm jira:doctor` to tune)
JIRA_ISSUE_TYPE=Bug                    # Work/issue type name to create (must exist in the space)
JIRA_PRIORITY_MODE=auto                # auto = send priority only if the space supports it | on | off
JIRA_PRIORITY_MAP=                     # JSON override, e.g. {"critical":"Highest","high":"High","medium":"Medium","low":"Low"}
JIRA_CATEGORY_TARGET=labels            # Where triage category goes: labels | components | none | customfield_xxxxx
JIRA_LABEL_PREFIX=                     # Optional prefix, e.g. "whatsapp-" -> label "whatsapp-bug"
JIRA_EXTRA_FIELDS=                     # JSON of extra fields for every issue, e.g. {"customfield_10050":{"value":"Mobile"}}
JIRA_API_VERSION=3                     # Jira REST API version
JIRA_DRY_RUN=false                     # true = log the payload instead of creating an issue (testing)
